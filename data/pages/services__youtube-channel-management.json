    {
      "index": 3,
      "className": "svd",
      "blocks": [
        {
          "type": "h2",
          "text": "WHAT IS INCLUDED IN OUR YOUTUBE SERVICE"
        },
        {
          "type": "p",
          "text": "YouTube is the world's second-largest search engine and a powerful long-form content channel. We help businesses and personal brands grow their YouTube presence with a combination of video SEO, content strategy, and community management."
        },
        {
          "type": "p",
          "text": "Retainers from €1,500 a month. Every engagement starts with a free audit, so you see the plan before you pay for anything."
        },
        {
          "type": "text",
          "text": "Video SEO"
        },
        {
          "type": "text",
          "text": "Title, description, tags, chapters, and thumbnail optimisation."
        },
        {
          "type": "text",
          "text": "Keyword Research"
        },
        {
          "type": "text",
          "text": "YouTube-specific keyword research for your niche."
        },
        {
          "type": "text",
          "text": "Content Strategy"
        },
        {
          "type": "text",
          "text": "Video ideas, upload schedule, and content pillar framework."
        },
        {
          "type": "text",
          "text": "Channel Optimisation"
        },
        {
          "type": "text",
          "text": "Channel art, about section, playlists, and featured content."
        },
        {
          "type": "text",
          "text": "Analytics"
        },
        {
          "type": "text",
          "text": "YouTube Analytics review and growth reporting."
        },
        {
          "type": "text",
          "text": "Community Management"
        },
        {
          "type": "text",
          "text": "Comment moderation and community engagement."
        }
      ]
    },
