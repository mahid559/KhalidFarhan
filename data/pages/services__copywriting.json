    {
      "index": 3,
      "className": "svd",
      "blocks": [
        {
          "type": "h2",
          "text": "WHAT IS INCLUDED IN OUR COPYWRITING SERVICE"
        },
        {
          "type": "p",
          "text": "Great copy is the difference between a website that gets visitors and one that gets customers. We write conversion-focused copy for websites, landing pages, ads, emails, and sales materials — based on your audience's real language, fears, and desires."
        },
        {
          "type": "p",
          "text": "Quoted per project after a free review. Every engagement starts with a free audit, so you see the plan before you pay for anything."
        },
        {
          "type": "text",
          "text": "Website Copy"
        },
        {
          "type": "text",
          "text": "Homepage, service pages, about page, and product descriptions."
        },
        {
          "type": "text",
          "text": "Ad Copy"
        },
        {
          "type": "text",
          "text": "Google Ads, Meta Ads, LinkedIn Ads — headlines and body copy that stop the scroll."
        },
        {
          "type": "text",
          "text": "Email Copy"
        },
        {
          "type": "text",
          "text": "Subject lines, sequences, broadcast campaigns."
        },
        {
          "type": "text",
          "text": "Landing Pages"
        },
        {
          "type": "text",
          "text": "Long-form sales pages and short-form lead gen pages."
        },
        {
          "type": "text",
          "text": "Brand Voice Guide"
        },
        {
          "type": "text",
          "text": "Documented voice and tone guidelines your whole team can use."
        },
        {
          "type": "text",
          "text": "Customer Research"
        },
        {
          "type": "text",
          "text": "Interviews and surveys to extract the language your customers actually use."
        }
      ]
    },
